# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# Cloudflare (Workers, D1, KV, R2, Pages, Email Routing)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_ZONE_NAME=aidprotocol.org
DEPLOY_HOSTNAME=dev.aidprotocol.org

# EVM deployer (Sepolia + Base Sepolia). Use a throwaway key, fund from faucets.
EVM_DEPLOYER_ADDRESS=0xyour-deployer-address
EVM_DEPLOYER_PRIVATE_KEY=your-deployer-private-key

# Optional RPC overrides for Foundry (chain/evm/foundry.toml)
# MAINNET_RPC_URL=
# BASE_RPC_URL=

# Solana deployer keypair is a separate file, NOT an env var:
#   chain/solana/.devnet-deployer.json  (gitignored)
# The Worker ADMIN_TOKEN is set as a Cloudflare secret, not here:
#   echo <token> | npx wrangler secret put ADMIN_TOKEN
