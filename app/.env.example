# Frontend (Vite) public env. Copy to app/.env and fill in.
# These are VITE_-prefixed, so they are bundled into the client. Use only public,
# domain-restricted values here (never private keys or Cloudflare secrets).

# Coinbase Developer Platform Client API key (OnchainKit / Smart Wallet / Onramp).
# Get it at https://portal.cdp.coinbase.com/products/onchainkit
VITE_ONCHAINKIT_API_KEY=

# CDP Paymaster & Bundler endpoint for gasless donations. Protect it with a
# contract allowlist + spend limit in the CDP dashboard. Use the endpoint for the
# network you are on (e.g. .../rpc/v1/base-sepolia/<key> for Base Sepolia).
VITE_PAYMASTER_URL=
